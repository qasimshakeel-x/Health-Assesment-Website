# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/longevity_platform

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Environment: development | production
# production mein JWT_SECRET strong (>=32 char) hona ZAROORI hai — warna server boot fail karega.
ENVIRONMENT=development

# JWT — generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# Anthropic Claude API
ANTHROPIC_API_KEY=your-api-key-here

# Groq API (free fast LLM — diet chat mein preferred)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# API Ninjas (nutrition/exercise queries — services/health_api.py)
# Missing raha toh health API calls silently empty [] return karti hain (BUG-9)



APININJAS_KEY=your-api-ninjas-key-here

# OPENAI (openai/gpt-4o-mini) — credits ke saath primary LLM
OPEN-AI=sk-your-openai-key-here

# Frontend
FRONTEND_URL=http://localhost:3000
